<?xml version="1.0" encoding="UTF-8"?>
<!--
  DA Infotech sitemap.

  The origin here must match the canonical link in index.html and the Sitemap
  line in robots.txt. Sitemaps require absolute URLs, so a relative path is
  silently discarded by crawlers.

  The site is a single page; the in-page anchors are navigation, not separate
  documents, and listing them would be duplicate-content noise. When real
  sub-pages exist, add one <url> block each.

  <lastmod> is deliberately omitted rather than guessed — a wrong date is
  worse than none.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://da-infotech-website.vercel.app/</loc>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
</urlset>
