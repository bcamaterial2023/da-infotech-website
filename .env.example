# DA Infotech — environment
#
# Copy the keys, NOT this file, into Vercel:
#   Project → Settings → Environment Variables (Production + Preview)
# Nothing here belongs in the repository with real values, and nothing here is
# ever read by the browser — api/contact.js runs on the server.


# ---------------------------------------------------------------------------
# REQUIRED — the contact form cannot deliver without this.
# ---------------------------------------------------------------------------
# Create a free account at https://resend.com using dainfotech7@gmail.com, then
# Settings → API Keys → Create. Sending permission is enough.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ---------------------------------------------------------------------------
# OPTIONAL — both have working defaults in api/contact.js.
# ---------------------------------------------------------------------------

# Where enquiries land. Defaults to dainfotech7@gmail.com.
CONTACT_TO=dainfotech7@gmail.com

# Who they appear to come from. Leave unset until a domain is verified in
# Resend: the default shared sender (onboarding@resend.dev) only delivers to
# the address that owns the Resend account, which is the point above.
# Once a domain is verified:
#   CONTACT_FROM=DA Infotech <website@yourdomain.com>
